# Local: no database configuration required. PostgreSQL runs locally via PGlite.
# Vercel: REQUIRED. Supabase Connect > Transaction pooler, URL-encode the password.
DATABASE_URL=
# Exact public origin, e.g. https://your-project.vercel.app
APP_URL=http://localhost:3000
# Real merchant PromptPay number (10-digit phone or 13-digit tax ID).
# Leave blank to disable QR. Never use a fake recipient in production.
PROMPTPAY_ID=
PROMPTPAY_NAME=
# Used ONLY by npm run db:setup to create the first admin on a remote DB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Seed public-domain sample art on remote DB only if explicitly set to true.
SEED_DEMO=false
