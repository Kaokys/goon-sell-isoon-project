# Local: no storage configuration required.
# Vercel: REQUIRED. Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Exact public origin, e.g. https://your-project.vercel.app
APP_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Web client.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Real merchant PromptPay number (10-digit phone or 13-digit tax ID).
# Leave blank to disable QR. Never use a fake recipient in production.
PROMPTPAY_ID=
PROMPTPAY_NAME=
# Bank transfer details. All three fields are required to enable this method online.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
